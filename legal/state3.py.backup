#!/usr/bin/env python3
"""
State v3 — Unified project + case state, PostgreSQL-backed.
Replaces state.py (JSON files) + case_db.py (DB).

Usage:
  python3 state3.py list                              # all projects
  python3 state3.py list --json                       # machine-readable
  python3 state3.py show <project_id>                 # full state
  python3 state3.py deadlines                         # all upcoming deadlines
  python3 state3.py done <id> "<step text>"           # move step pending→completed
  python3 state3.py add <id> pending|completed "<step>"
  python3 state3.py progress <id> <0-100>
  python3 state3.py status <id> <active|paused|done|blocked>
  python3 state3.py phase <id> <phase>
  python3 state3.py priority <id> <critical|high|medium|low>
  python3 state3.py deadline <id> <key> <YYYY-MM-DD> "<desc>"
  python3 state3.py activity <id> "<text>"
  python3 state3.py note <id> <type> "<text>"
  python3 state3.py conf <id> <key> <value>
  python3 state3.py init <id> "<name>" <tier> [contact]
  python3 state3.py priority-list                      # auto-priority check
  python3 state3.py migrate                            # JSON → DB migration
"""

import sys, os, json
import psycopg2
import psycopg2.extras
from datetime import date, datetime

DSN = os.environ.get("STATE_DB_DSN", "dbname=orchestrator user=postgres")

